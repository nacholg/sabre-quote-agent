# .env (PROD)
SABRE_ENV=PROD
SABRE_BASE_URL=https://api.platform.sabre.com
SABRE_TOKEN_TYPE=password
SABRE_CLIENT_ID=YOUR_CLIENT_ID
SABRE_CLIENT_SECRET=YOUR_PROD_CLIENT_SECRET
SABRE_USERNAME=YOUR_EPR-YOURPCC-AA
SABRE_PASSWORD=YOUR_PROD_PASSWORD
SABRE_PCC=YOURPCC
SABRE_READ_ONLY=1
SABRE_ALLOWED_PATHS_PROD=/v5/offers/shop,/v5/shop/flights/revalidate
SABRE_SHOPPING_PATH=/v5/offers/shop
SABRE_REVALIDATE_PATH=/v5/shop/flights/revalidate

# Write-capable workflows remain disabled by default.
SABRE_CREATE_BOOKING_ENABLED=false
SABRE_CREATE_BOOKING_PROD_ENABLED=false
SABRE_PNR_PRICING_ENABLED=false
SABRE_SECURE_FLIGHT_ENABLED=false

# Create a separate .env.cert for CERT:
# SABRE_ENV=CERT
# SABRE_BASE_URL=https://api.cert.platform.sabre.com
# SABRE_TOKEN_TYPE=client_credentials
# SABRE_CLIENT_ID=YOUR_CLIENT_ID
# SABRE_CLIENT_SECRET=YOUR_CERT_CLIENT_SECRET
# SABRE_USERNAME=YOUR_CERT_EPR-YOURPCC-AA
# SABRE_PASSWORD=YOUR_CERT_PASSWORD
# SABRE_PCC=YOURPCC
# SABRE_READ_ONLY=1
# SABRE_SHOPPING_PATH=/v5/offers/shop
# SABRE_REVALIDATE_PATH=/v5/shop/flights/revalidate
# SABRE_CREATE_BOOKING_ENABLED=false
# SABRE_CREATE_BOOKING_PROD_ENABLED=false
# SABRE_PNR_PRICING_ENABLED=false
# SABRE_SECURE_FLIGHT_ENABLED=false
